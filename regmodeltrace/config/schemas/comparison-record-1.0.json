{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regmodeltrace.local/schemas/comparison-record-1.0.json",
  "title": "RegModelTrace requirement-implementation comparison record",
  "type": "object",
  "properties": {
    "comparison_id": {
      "type": "string",
      "minLength": 1
    },
    "requirement_dimension": {
      "type": "object",
      "properties": {
        "dimension_id": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "constraint_status": {
          "type": "string",
          "enum": [
            "PRESCRIBED",
            "NOT_PRESCRIBED",
            "UNRESOLVED"
          ]
        },
        "required_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "normative_wording": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualification_assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "source_assertion_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "dimension_id",
        "label",
        "constraint_status",
        "required_value",
        "scope",
        "normative_wording",
        "qualification_assertion_ids",
        "source_assertion_ids"
      ],
      "additionalProperties": false
    },
    "vendor_dimension": {
      "type": "object",
      "properties": {
        "organization_id": {
          "type": "string",
          "minLength": 1
        },
        "documented_value": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_types": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "VENDOR_COMPLIANCE_ASSERTION",
              "VENDOR_METHODOLOGY",
              "VENDOR_JUSTIFICATION",
              "MODEL_UPDATE",
              "NO_CHANGE_STATEMENT",
              "VERSION_BASELINE",
              "QUANTITATIVE_OBSERVATION"
            ]
          },
          "uniqueItems": true
        },
        "source_assertion_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "organization_id",
        "documented_value",
        "evidence_types",
        "source_assertion_ids"
      ],
      "additionalProperties": false
    },
    "reviewer_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activity": {
            "type": "string",
            "enum": [
              "REVIEWED",
              "VERIFIED",
              "QUESTIONED",
              "CHALLENGED",
              "REQUIRED_CHANGE",
              "DISPOSITION_RECORDED"
            ]
          },
          "scope_note": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_assertion_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "activity",
          "scope_note",
          "source_assertion_ids"
        ],
        "additionalProperties": false
      }
    },
    "evidence_scope": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "RETRIEVED_BUNDLE",
            "FIXED_CORPUS"
          ]
        },
        "corpus_id": {
          "type": "string",
          "minLength": 1
        },
        "search_status": {
          "type": "string",
          "enum": [
            "COMPLETE",
            "PARTIAL",
            "NOT_RUN"
          ]
        },
        "unavailable_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "corpus_id",
        "search_status",
        "unavailable_dependencies"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "comparison_id",
    "requirement_dimension",
    "vendor_dimension",
    "reviewer_evidence",
    "evidence_scope"
  ],
  "additionalProperties": false
}
